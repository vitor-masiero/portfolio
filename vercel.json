{
    "version": 2,
    "builds": [
        {
            "src": "dist/spa/**",
            "use": "@vercel/static"
        },
        {
            "src": "api/index.ts",
            "use": "@vercel/node",
            "config": {
                "includeFiles": "dist/server/**"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.ts"
        },
        {
            "src": "/(.*)",
            "dest": "/dist/spa/$1"
        }
    ]
}